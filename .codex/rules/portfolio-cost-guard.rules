prefix_rule(
    pattern = ["git", "merge"],
    decision = "forbidden",
    justification = "Merge należy do Wizjonera; Codex pozostawia lokalne zmiany robocze.",
)

prefix_rule(
    pattern = ["git", "rebase"],
    decision = "forbidden",
    justification = "Rebase należy do Wizjonera; Codex pozostawia lokalne zmiany robocze.",
)

prefix_rule(
    pattern = ["git", "cherry-pick"],
    decision = "forbidden",
    justification = "Cherry-pick należy do Wizjonera; Codex pozostawia lokalne zmiany robocze.",
)

prefix_rule(
    pattern = ["git", "revert"],
    decision = "forbidden",
    justification = "Revert należy do Wizjonera; Codex pozostawia lokalne zmiany robocze.",
)

prefix_rule(
    pattern = ["git", "reset"],
    decision = "forbidden",
    justification = "Reset historii lub zmian należy do Wizjonera; Codex pozostawia lokalne zmiany robocze.",
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "Czyszczenie zmian należy do Wizjonera; Codex pozostawia lokalne zmiany robocze.",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "Publikacja zmian i Pull Request delivery należą do Wizjonera.",
)

prefix_rule(
    pattern = ["gh", "pr", ["create", "edit", "ready", "review", "merge", "close", "reopen"]],
    decision = "forbidden",
    justification = "Tworzenie, publikacja, akceptacja, merge i mutowanie pull requestów należą do Wizjonera.",
)

prefix_rule(
    pattern = ["/opt/codex/mcp/make_pr.py"],
    decision = "forbidden",
    justification = "Codex nie uruchamia lokalnego mechanizmu MCP w celu utworzenia Pull Requesta.",
)
