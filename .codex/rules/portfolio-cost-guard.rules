prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "Push należy do Wizjonera; Codex pozostawia lokalne zmiany robocze.",
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "forbidden",
    justification = "Commit należy do Wizjonera; Codex pozostawia lokalne zmiany robocze.",
)

prefix_rule(
    pattern = ["git", "merge"],
    decision = "forbidden",
    justification = "Merge należy do Wizjonera; Codex pozostawia lokalne zmiany robocze.",
)

prefix_rule(
    pattern = ["git", "rebase"],
    decision = "forbidden",
    justification = "Rebase należy do Wizjonera; Codex pozostawia lokalne zmiany robocze.",
)

prefix_rule(
    pattern = ["git", "cherry-pick"],
    decision = "forbidden",
    justification = "Cherry-pick należy do Wizjonera; Codex pozostawia lokalne zmiany robocze.",
)

prefix_rule(
    pattern = ["git", "revert"],
    decision = "forbidden",
    justification = "Revert należy do Wizjonera; Codex pozostawia lokalne zmiany robocze.",
)

prefix_rule(
    pattern = ["git", "reset"],
    decision = "forbidden",
    justification = "Reset historii lub zmian należy do Wizjonera; Codex pozostawia lokalne zmiany robocze.",
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "Czyszczenie zmian należy do Wizjonera; Codex pozostawia lokalne zmiany robocze.",
)

prefix_rule(
    pattern = ["gh", "pr", ["create", "merge", "review", "edit", "close", "reopen", "ready"]],
    decision = "forbidden",
    justification = "Mutowanie pull requestów należy do Wizjonera; Codex pozostawia lokalne zmiany robocze.",
)
